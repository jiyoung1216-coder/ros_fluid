<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="hill">
    <static>true</static>
    <link name="hill_link">
      <collision name="hill_collision">
        <geometry>
          <sphere>
            <radius>2.5</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>0.9</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="hill_visual">
        <geometry>
          <sphere>
            <radius>2.5</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.42 0.32 0.2 1</ambient>
          <diffuse>0.5 0.38 0.24 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
