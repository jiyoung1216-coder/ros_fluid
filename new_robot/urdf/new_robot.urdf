    <link name="water_tank">
        <!-- 질량 = 고정 질량 m0(0.6899kg, Housner 등가모델). 슬로싱 질량 m1(0.1654kg)은
             slosh_bob 링크로 분리했으므로 여기 중복 포함하지 않는다. 관성은 원래
             0.5kg 기준값을 질량비(0.6899/0.5)로 스케일링. -->
        <inertial>
            <mass value="0.6899" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.002484" iyy="0.002484" izz="0.001242" ixy="0" ixz="0" iyz="0" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://new_robot/meshes/water_tank.stl" scale="1 1 1" />
            </geometry>
            <material name="water_tank_blue">
                <color rgba="0.2 0.5 0.9 1" />
            </material>
        </visual>
    </link>

<!-- 수정 후 -->
    <joint name="water_tank_joint" type="fixed">
        <origin xyz="-0.115419 0.019334 0.169057" rpy="0.000498 1.545365 3.080375" />
        <parent link="default_4" />
        <child link="water_tank" />
    </joint>

    <!-- ===== Housner 등가 슬로싱 진자 (sim_control/가제보_환경_수정요청.md 참조) =====
         R=55mm, h=90mm 기준. spherical 조인트가 없으므로 직교 revolute 2개로 유니버설을
         만든다. slosh_pendulum_x/y 각도가 슬로싱 지표(analyze_log.py의 slosh_x/y_deg). -->
    <link name="slosh_gimbal_x">
        <inertial>
            <mass value="0.005" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </link>

    <link name="slosh_bob">
        <inertial>
            <mass value="0.1654" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="2.65e-5" ixy="0" ixz="0" iyy="2.65e-5" iyz="0" izz="2.65e-5" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry><sphere radius="0.012" /></geometry>
            <material name="slosh_blue"><color rgba="0.2 0.6 1.0 0.8" /></material>
        </visual>
    </link>

    <joint name="slosh_pendulum_x" type="revolute">
        <origin xyz="0 0 0.00294" rpy="0 0 0" />
        <axis xyz="1 0 0" />
        <parent link="water_tank" />
        <child link="slosh_gimbal_x" />
        <limit lower="-0.6" upper="0.6" effort="1.0" velocity="20.0" />
        <dynamics damping="5.39e-5" friction="0.0" />
    </joint>

    <joint name="slosh_pendulum_y" type="revolute">
        <origin xyz="0 0 -0.03002" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <parent link="slosh_gimbal_x" />
        <child link="slosh_bob" />
        <limit lower="-0.6" upper="0.6" effort="1.0" velocity="20.0" />
        <dynamics damping="5.39e-5" friction="0.0" />
    </joint>
</robot>
