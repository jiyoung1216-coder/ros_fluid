<!--URDF generated by ONSHAPE BY PTC INC, 1.219-->
<robot name="new_robot">
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
            <left_joint>revolute_5</left_joint>
            <left_joint>revolute_6</left_joint>
            <right_joint>revolute_3</right_joint>
            <right_joint>revolute_4</right_joint>
            <wheel_separation>0.5201</wheel_separation>
            <wheel_radius>0.105</wheel_radius>
            <odom_publish_frequency>20</odom_publish_frequency>
            <topic>cmd_vel</topic>
            <frame_id>odom</frame_id>
            <child_frame_id>root</child_frame_id>
            <max_linear_acceleration>1.0</max_linear_acceleration>
            <min_linear_acceleration>-1.0</min_linear_acceleration>
            <max_angular_acceleration>2.0</max_angular_acceleration>
            <min_angular_acceleration>-2.0</min_angular_acceleration>
        </plugin>
            <!-- p_gain/d_gain — motor_test_MIT.ino의 MOTOR_KP=1.0/MOTOR_KD=0.05를
                 그대로 쓰면(i_gain=0, P전용) 여기 CAD 트레이+짐벌 조립체의
                 중력 토크를 못 버텨서 정지 상태에서도 조인트가 한계(±25도)
                 까지 처져버렸다(2026-08-31 실측 확인). 실제 모터 값은 실물
                 하드웨어의 실제 부하로 튜닝된 값이라 sim의 (CAD 근사)
                 질량/무게중심이 다르면 그대로 못 쓴다 — i_gain을 넣어
                 봤더니 이번엔 진동(오버슈트)해서, 대신 p_gain만 올려
                 중력을 버틸 강성을 확보했다. d_gain은 p 대비 원래 비율
                 (0.05)을 유지. p=20,d=1.5였던 이전 임의값보다는 훨씬
                 부드럽다.

                 2026-09-05 실험 기록 - tray_pitch_deg가 정지 상태에서도
                 계속 약 -3.4도(roll은 -0.76도)에 고정되는 현상을 발견해
                 처음엔 이 PID의 중력 처짐(정상상태 오차)으로 의심하고
                 p_gain을 3배(15->45, d_gain도 비례해 2.25)로 올려 재측정
                 했는데 값이 전혀 안 줄었다(-3.39도로 거의 동일). 게인에
                 비례하지 않는 걸 보면 토크 처짐이 아니라 조인트 각도 0과
                 트레이(water_tank) 실제 수평 사이의 고정 기하 오프셋으로
                 보여 원래 게인(15/0.75)으로 되돌렸다. 실제 보정은
                 sim_control의 tray_zero_offset_roll_rad/pitch_rad
                 (gimbal_control_core.py CoreConfig)로 하는 게 맞다 — 그
                 필드가 정확히 이 목적("조인트각 0이 트레이 수평과
                 일치하지 않는 만큼")으로 이미 존재한다. -->
            <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>revolute_1</joint_name>
            <topic>/gimbal_roll_cmd</topic>
            <p_gain>15.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.75</d_gain>
        </plugin>
            <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
            <joint_name>revolute_2</joint_name>
            <topic>/gimbal_pitch_cmd</topic>
            <p_gain>15.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.75</d_gain>
        </plugin>

        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"></plugin>

        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
        </plugin>

        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_model_pose>false</publish_model_pose>
            <publish_visual_pose>false</publish_visual_pose>
            <publish_collision_pose>false</publish_collision_pose>
            <publish_sensor_pose>false</publish_sensor_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <static_publisher>false</static_publisher>
        </plugin>

    </gazebo>
    <gazebo reference="body2">
        <sensor name="chassis_imu" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>imu</topic>
        </sensor>
    </gazebo>
    <gazebo reference="default_4">
        <sensor name="tray_imu" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>imu_tray</topic>
        </sensor>
    </gazebo>

